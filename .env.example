# Browser-safe Supabase project configuration. These two values are public by design.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# Local diagnostic origin only. Replace with the frozen GitHub Pages origin before deployment.
VITE_APP_ORIGIN=http://localhost:5173

# Edge Functions receive these only from Supabase project Secrets; never put real values here.
TAOBAO_APP_KEY=replace-in-supabase-secrets
TAOBAO_APP_SECRET=replace-in-supabase-secrets
TAOBAO_PID=replace-in-supabase-secrets
TAOBAO_ADZONE_ID=replace-in-supabase-secrets
ZHIHU_ACCESS_SECRET=replace-in-supabase-secrets
TAOKE_CONVERT_ACCESS_KEY=replace-in-supabase-secrets
